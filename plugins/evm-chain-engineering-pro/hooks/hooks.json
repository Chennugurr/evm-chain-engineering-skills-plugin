{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-plugins/evm-chain-engineering-pro}}/scripts/policy_guard.py\" --stdin --json --strict --hook-output",
            "timeout": 10,
            "statusMessage": "Checking blockchain safety policy"
          }
        ]
      }
    ]
  }
}
