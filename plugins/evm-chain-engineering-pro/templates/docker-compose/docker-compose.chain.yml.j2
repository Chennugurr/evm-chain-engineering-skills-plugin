# Rendered for {{ chain_name }}. VERIFY_CURRENT_DOCS before production use.
services:
  {{ role }}:
    image: ghcr.io/example/{{ stack }}-{{ role }}:{{ image_tag }} # TODO: pin digest for production
    restart: unless-stopped
    user: "10001:10001"
    environment:
      CHAIN_ENVIRONMENT: "{{ environment }}"
      RPC_SECRET_REF: "${{{ stack | upper }}_RPC_SECRET_REF:-external-secret-ref}"
    ports:
      - "127.0.0.1:{{ rpc_port }}:8545"
    volumes:
      - chain-data:/var/lib/{{ chain_name }}
volumes:
  chain-data: {}
