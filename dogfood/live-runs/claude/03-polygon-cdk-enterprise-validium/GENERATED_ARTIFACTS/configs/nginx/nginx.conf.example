# Planning fixture only. Do not expose admin/debug RPC publicly.
server {
    listen 443 ssl;
    server_name rpc.example.invalid;

    # TLS certificate paths are placeholders. Configure through your platform secret store.
    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;

    # Add platform rate limiting before public use.
    location / {
        proxy_pass http://127.0.0.1:8545;
        proxy_set_header Host $host;
    }

    # Admin/debug endpoints must remain private and are intentionally not proxied here.
}
