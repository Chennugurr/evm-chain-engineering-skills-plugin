{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v0.3 live transcript metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform",
    "plugin_version",
    "git_commit",
    "prompt_id",
    "prompt_file",
    "session_date",
    "operator",
    "install_method",
    "transcript_markdown",
    "skills_observed",
    "subagents_observed",
    "hooks_observed",
    "generated_artifact_bundle",
    "validation_commands",
    "validation_results",
    "policy_events",
    "manual_interventions",
    "failures",
    "redactions",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "platform": {"enum": ["codex", "claude"]},
    "plugin_version": {"type": "string"},
    "git_commit": {"type": "string"},
    "prompt_id": {"type": "string"},
    "prompt_file": {"type": "string"},
    "session_date": {"type": "string"},
    "operator": {"type": "string"},
    "install_method": {"type": "string"},
    "transcript_markdown": {"type": "string"},
    "skills_observed": {"type": "array", "items": {"type": "string"}},
    "subagents_observed": {"type": "array", "items": {"type": "string"}},
    "hooks_observed": {"type": "array", "items": {"type": "string"}},
    "generated_artifact_bundle": {"type": ["string", "null"]},
    "validation_commands": {"type": "array", "items": {"type": "string"}},
    "validation_results": {"type": "array", "items": {"type": "object"}},
    "policy_events": {"type": "array", "items": {"type": "object"}},
    "manual_interventions": {"type": "array", "items": {"type": "string"}},
    "failures": {"type": "array", "items": {"type": "string"}},
    "redactions": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
